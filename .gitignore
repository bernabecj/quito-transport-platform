# Python
__pycache__/
*.py[cod]
*.egg-info/
.coverage
.venv/
venv/
dist/
build/

# Vendored installers (the dev container installs the AWS CLI itself)
awscliv2.zip

# Environment
.env
.env.*
!.env.example

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/

# Great Expectations
gx/uncommitted/
great_expectations/uncommitted/
# Pristine copies made by scripts/break_samples.py; scripts/restore_samples.py removes it
data/samples/.backup/

# AWS credentials (never commit these)
.aws/

# IDE
.vscode/
.idea/
*.iml
.claude/
data/local/*
quito-wheels/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
airflow/logs/

# Terraform
# Plan files are ZIP archives containing a full copy of state, so they carry the
# same plaintext secrets state does. Never commit them.
infrastructure/terraform/.terraform/
infrastructure/terraform/*.tfstate
infrastructure/terraform/*.tfstate.backup
infrastructure/terraform/.terraform.tfstate.lock.info
*.tfplan
*.tfvars
!*.tfvars.example

# Astro / local Airflow
airflow/.env
airflow/.astro/
